<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>goducky</id>
    <version>0.1.0</version>
    <title>GoDucky CLI</title>
    <authors>Go-Ducky</authors>
    <owners>Go-Ducky</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <licenseUrl>https://github.com/Go-Ducky/goducky-cli/blob/main/LICENSE</licenseUrl>
    <projectUrl>https://github.com/Go-Ducky/goducky-cli</projectUrl>
    <description>GoDucky CLI is an AI coding agent that runs in your terminal. It works with local models (Ollama) and API providers (OpenAI, Anthropic, Gemini).</description>
    <summary>AI coding agent for the terminal with local and API model support.</summary>
    <tags>ai coding cli agent terminal tui llm ollama openai anthropic gemini</tags>
    <packageSourceUrl>https://github.com/Go-Ducky/goducky-cli</packageSourceUrl>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
